{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {"type":"string","defaultValue":"[concat('catat-harian-', uniqueString(resourceGroup().id))]","minLength":2,"maxLength":55},
    "location": {"type":"string","defaultValue":"[resourceGroup().location]"},
    "firebaseProjectId": {"type":"string","minLength":1},
    "allowedFirebaseUid": {"type":"securestring","minLength":1},
    "spreadsheetId": {"type":"securestring","minLength":10},
    "googleServiceAccountJson": {"type":"securestring","minLength":20}
  },
  "variables": {"planName":"[concat(parameters('appName'), '-free')]"},
  "resources": [
    {
      "type":"Microsoft.Web/serverfarms","apiVersion":"2023-12-01",
      "name":"[variables('planName')]","location":"[parameters('location')]",
      "kind":"linux","sku":{"name":"F1","tier":"Free","size":"F1","capacity":1},
      "properties":{"reserved":true}
    },
    {
      "type":"Microsoft.Web/sites","apiVersion":"2023-12-01",
      "name":"[parameters('appName')]","location":"[parameters('location')]","kind":"app,linux",
      "dependsOn":["[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"],
      "properties": {
        "serverFarmId":"[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly":true,"clientAffinityEnabled":false,
        "siteConfig": {
          "linuxFxVersion":"PYTHON|3.12","alwaysOn":false,"numberOfWorkers":1,
          "ftpsState":"Disabled","minTlsVersion":"1.2","http20Enabled":true,
          "appCommandLine":"python _azure_startup.py",
          "appSettings": [
            {"name":"SCM_DO_BUILD_DURING_DEPLOYMENT","value":"1"},
            {"name":"APP_ENV","value":"production"},
            {"name":"LOG_LEVEL","value":"INFO"},
            {"name":"WEB_CONCURRENCY","value":"1"},
            {"name":"UVICORN_WORKERS","value":"1"},
            {"name":"LEDGER_CHECKPOINT_PATH","value":"/home/catat-data/ledger-checkpoint.json"},
            {"name":"FIREBASE_PROJECT_ID","value":"[parameters('firebaseProjectId')]"},
            {"name":"ALLOWED_FIREBASE_UID","value":"[parameters('allowedFirebaseUid')]"},
            {"name":"GOOGLE_SHEETS_SPREADSHEET_ID","value":"[parameters('spreadsheetId')]"},
            {"name":"GOOGLE_SERVICE_ACCOUNT_JSON","value":"[parameters('googleServiceAccountJson')]"}
          ]
        }
      }
    }
  ],
  "outputs": {"appName":{"type":"string","value":"[parameters('appName')]"}}
}
