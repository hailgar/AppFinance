# Copy to deploy/.env on an existing Linux host. Never commit real values.
API_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com
GOOGLE_CREDENTIALS_FILE=/absolute/private/path/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_private_sheet_id
FIREBASE_PROJECT_ID=replace_with_project_id
ALLOWED_FIREBASE_UID=replace_with_one_uid
APP_ENV=production
LOG_LEVEL=INFO
