# Isi di backend/.env lokal. Jangan commit file .env atau JSON service-account.
# Jika memakai managed ADC pada hosting, GOOGLE_APPLICATION_CREDENTIALS dapat dihapus.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_private_spreadsheet_id
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
ALLOWED_FIREBASE_UID=replace_with_one_firebase_uid
APP_ENV=development
LOG_LEVEL=INFO
# Pertahankan direktori ini pada restart/redeploy. Satu worker dan satu replica.
LEDGER_CHECKPOINT_PATH=data/ledger-checkpoint.json
CACHE_TTL_SECONDS=2
UPSTREAM_TIMEOUT_SECONDS=10
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=16384
# Android native tidak memerlukan CORS. Web client, bila ditambahkan, pakai origin eksplisit.
CORS_ORIGINS=[]
